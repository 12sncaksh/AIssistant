# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- 运行时数据 / 隐私 / 密钥（开源务必保留这些规则）----
config/auth.json
config/config.json
config/mcp.json
config/dsh_acp_overlay.yml
config/dsh_sessions.json
config/apps.json
config/live2d_emotions.json
# 兜底：config 下只放行模板目录，其余 json/yml 一律不入库，
# 避免以后新增配置项（网关地址、密钥等）被误提交。
config/*.json
config/*.yml
!config/templates/
data/
logs/
output.txt
generated/
agent_workspace/
archive/
.env
*.db
*.log

# ---- 内部记录/文档（不公开）----
# docs/ 与「工作文档」不随仓库发布，README / scripts 里不要引用这些文件。
工作文档
docs/

# ---- 开发期临时产物与测试脚本（不公开）----
# lab/ 是开发时的界面截图（由 scripts/shot_config_dialog.py 生成），README 不引用它。
lab/
# 真机验证清单、散落在根目录的临时测试脚本：内部使用。
TEST_CHECKLIST.md
test_qthread_shutdown.py
# 测试脚本一律不发布：本仓库只公开源码与运行 / 打包 / 自检脚本。
# 注意：scripts/test_dsh_bridge.py 在更早的提交里已经入库，本规则不会自动移除它
#（它在本项目里的定位是「桥接自检」入口，README 的 DSH 一节引用了它）。
scripts/test_*.py

# ---- 本地备份 / 临时文件 ----
*.bak
*.bak-*

# ---- 打包产物 ----
/build/
/dist/
*.zip

# ---- 编辑器 ----
.vscode/

# ---- Live2D 资源 ----
# 仅上传免费模型「大肥鱼」；Cubism Core / Framework / 引擎 / 示例模型(Hiyori,Mao) 有再分发限制，不上传。
# 若之后想公开自己的前端页面(html/js)，在下面追加对应的 ! 白名单即可。
/assets/web_resources/*
!/assets/web_resources/dist/
/assets/web_resources/dist/*
!/assets/web_resources/dist/Resources/
/assets/web_resources/dist/Resources/*
!/assets/web_resources/dist/Resources/大肥鱼/
